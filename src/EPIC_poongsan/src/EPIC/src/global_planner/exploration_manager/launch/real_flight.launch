<launch>
  <!-- ===================================================================
       EPIC 실비행 launch  (MARSIM 시뮬 없음)

       전제: run_stack.sh 가 먼저 떠 있어야 함
         mavros(px4) + livox_ros_driver + FAST-LIO
         => /Odometry, /cloud_registered, /mavros/* 가 흐르는 상태

       이 launch 가 띄우는 것:
         1) exploration_node   : EPIC 플래너 (config: real.yaml)
         2) traj_server        : MINCO 궤적 샘플링 -> /position_cmd
         3) px4_ctrl_bridge    : /position_cmd -> /mavros/setpoint_raw/local
         4) waypoint_generator : rviz/goal -> FSM 트리거(/waypoint_generator/waypoints)
         5) rviz (선택)

       OFFBOARD 진입/arm 은 기본적으로 사람이 RC/QGC로 (auto_arm:=false).
       =================================================================== -->

  <arg name="config_file" default="real.yaml"/>
  <arg name="odom_topic"  default="/Odometry"/>          <!-- FAST-LIO odom -->
  <arg name="auto_arm"    default="false"/>              <!-- true 면 브리지가 OFFBOARD+arm 자동 요청 -->
  <arg name="rviz"        default="true"/>
  <!-- 회피 on/off 마스터 스위치는 real.yaml 의 local_avoidance/enable 이다 (true/false).
       이 launch 인자는 "노드를 아예 띄울지"만 결정하는 하드 스위치 (기본 true 유지 권장:
       real.yaml 값만 바꾸면 됨. 노드가 떠 있어도 yaml=false 면 완전 비활성). -->
  <arg name="enable_avoidance" default="true"/>
  <arg name="record"      default="true"/>  <!-- 기록 전체 마스터 스위치 (노드 자체 on/off) -->
  <!-- 저장 폴더: 빈 값(기본) = epic_planner 패키지 경로를 동적 감지해 <pkg>/records 사용 -->
  <arg name="record_dir"  default=""/>
  <arg name="record_args" default="-a"/>    <!-- rosbag record 인자 (예: 토픽만 추리려면 변경) -->
  <!-- 산출물별 개별 on/off -->
  <arg name="record_bag"    default="true"/>  <!-- .bag (rosbag record) -->
  <arg name="record_log"    default="true"/>  <!-- .log (/rosout 콘솔 로그) -->
  <arg name="record_params" default="true"/>  <!-- .params.yaml (rosparam dump 메타데이터) -->
  <arg name="record_events" default="true"/>  <!-- .events.log (구조화 이벤트) -->
  <!-- 회피 노드용 odom: PX4 EKF local 프레임이어야 함(=setpoint_raw/local 프레임). EPIC의 /Odometry 와 다름. -->
  <arg name="avoid_odom_topic" default="/mavros/local_position/odom"/>

  <!-- 1) 플래너 본체 (algorithm.xml 재사용, config 만 real.yaml 로) -->
  <include file="$(find epic_planner)/launch/algorithm.xml">
    <arg name="config_file" value="$(arg config_file)"/>
  </include>

  <!-- 1.5) ML-X FOV 에뮬레이션 crop 브릿지 — on/off 는 real.yaml 의 cloud_crop/enable
       하나로 제어 (launch 수정 불필요). enable=true 면 cloud_topic 을 crop 해
       cloud_crop/output_topic 으로 재발행하고 exploration_node 가 그걸 구독,
       false 면 이 노드는 곧바로 자진 종료(clean exit)하고 EPIC 은 raw 를 구독. -->
  <node pkg="epic_planner" name="cloud_crop_bridge" type="cloud_crop_bridge" output="screen">
    <rosparam file="$(find epic_planner)/config/$(arg config_file)" command="load"/>
  </node>

  <!-- 2) traj_server : 시뮬과 달리 /position_cmd remap 하지 않음
       (브리지가 글로벌 /position_cmd 를 구독하므로 그대로 둔다) -->
  <node pkg="plan_manage" name="traj_server" type="traj_server" output="screen">
    <param name="odometry_topic" value="$(arg odom_topic)"/>
  </node>

  <!-- 3) PX4 OFFBOARD 브리지 -->
  <node pkg="plan_manage" name="px4_ctrl_bridge" type="px4_ctrl_bridge" output="screen">
    <param name="odom_topic"   value="$(arg odom_topic)"/>
    <param name="auto_arm"     value="$(arg auto_arm)"/>
    <param name="cmd_timeout"  value="0.5"/>
    <param name="use_accel_ff" value="false"/>
    <param name="use_yawrate"  value="true"/>
    <!-- 반사회피 MUX: flag=1 동안 /target_avoidance 를 EPIC 명령 대신 PX4로 보냄 -->
    <param name="enable_avoidance"  value="$(arg enable_avoidance)"/>
    <param name="avoid_cmd_timeout" value="0.3"/>
    <param name="flag_timeout"      value="0.5"/>
    <param name="replan_on_release" value="true"/>
  </node>

  <!-- 3.5) 반사 국소회피 노드 (LiDAR 포텐셜필드). /target_avoidance + /FSM_flag_avoidance 발행.
       enable_avoidance:=false 면 노드 자체를 띄우지 않음(브리지 MUX도 EPIC만 통과). -->
  <include file="$(find local_avoidance)/launch/local_avoidance.launch" if="$(arg enable_avoidance)">
    <arg name="lidar_topic" value="/livox/lidar"/>
    <arg name="odom_topic"  value="$(arg avoid_odom_topic)"/>
  </include>

  <!-- 4) 트리거용 waypoint_generator (rviz '2D Nav Goal' -> /move_base_simple/goal) -->
  <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator"
        output="screen">
    <remap from="~odom" to="$(arg odom_topic)"/>
    <remap from="~goal" to="/move_base_simple/goal"/>
    <remap from="~traj_start_trigger" to="/traj_start_trigger"/>
    <param name="waypoint_type" value="point"/>
  </node>

  <!-- 4.2) 녹화: EPIC FSM 기동(/planning/state 첫 발행 = INIT)을 감지하면 즉시
       rosbag record 시작, FSM 이 LANDED(착지+disarm) 가 되면 정상 마감.
       bag + rosparam 덤프(.params.yaml) + .log + .events.log 저장.
       record:=false 로 끌 수 있음. -->
  <node pkg="epic_planner" name="record_on_goal" type="record_on_goal.py"
        output="screen" if="$(arg record)">
    <param name="record_dir"  value="$(arg record_dir)"/>
    <param name="record_args" value="$(arg record_args)"/>
    <param name="name_prefix" value="epic"/>
    <param name="once"        value="true"/>
    <param name="save_bag"    value="$(arg record_bag)"/>
    <param name="save_log"    value="$(arg record_log)"/>
    <param name="save_params" value="$(arg record_params)"/>
    <param name="save_events" value="$(arg record_events)"/>
  </node>

  <!-- 4.5) 드론 mesh 시각화 (시뮬의 quad0_odom_visualization 과 동일).
       /quad0_odom_visualization/robot 으로 yunque.dae 메시를 publish -> rviz 가 그대로 구독.
       순수 시각화 노드라 비행 제어에는 영향 없음. -->
  <node pkg="odom_visualization" name="quad0_odom_visualization" type="odom_visualization"
        output="screen">
    <remap from="~odom" to="$(arg odom_topic)"/>
    <!-- real.yaml 공유 로드: lidar_perception/lidar_pitch 를 메시 장착각 보상에 사용
         (라이다를 기울여 달면 /Odometry 자세=센서 자세라 메시가 숙여 보이는 것 방지) -->
    <rosparam file="$(find epic_planner)/config/$(arg config_file)" command="load"/>
    <param name="color/a" value="1.0"/>
    <param name="color/r" value="0.0"/>
    <param name="color/g" value="1.0"/>
    <param name="color/b" value="1.0"/>
    <param name="covariance_scale" value="100.0"/>
    <param name="robot_scale" value="1.0"/>
    <param name="quadrotor_name" value="quad0"/>
    <param name="drone_id" value="0"/>
    <param name="mesh_resource" value="package://odom_visualization/meshes/yunque.dae"/>
  </node>

  <!-- 5) rviz (선택) — real.rviz 는 이제 시뮬 traj.rviz 복사본(색/크기/형태 동일).
       Fixed Frame=world. 실기 적응: buffered_cloud 토픽 /cloud_registered, 드론 mesh 는
       위 quad0_odom_visualization 노드가 publish. occ/frt 복셀이 world 프레임에서 보이려면
       camera_init->world static TF (4_tf_odom_relay.sh) 가 떠 있어야 한다. -->
  <group if="$(arg rviz)">
    <node name="rvizvisualisation" pkg="rviz" type="rviz" output="log"
          args="-d $(find epic_planner)/config/real.rviz" />
  </group>

</launch>
