<launch>
  <!-- Re-run the current EPIC build from recorded odometry/cloud inputs.
       Recorded planner outputs are filtered by bag_replay.py, so RViz shows
       only trajectories and maps produced by the current source build. -->
  <arg name="bag" doc="실비행 rosbag 절대 경로"/>
  <arg name="config_file" default="real2.yaml"
       doc="현재 플래너에 적용할 profile yaml"/>
  <arg name="rate" default="1.0" doc="재생 배속"/>
  <arg name="start" default="0.0" doc="bag 시작 오프셋[s]"/>
  <arg name="duration" default="" doc="재생 길이[s], 빈 값이면 끝까지"/>
  <arg name="delay" default="6.0" doc="센서 재생 전 플래너 기동 대기시간[s]"/>
  <arg name="rviz" default="true"/>
  <arg name="rviz_config"
       default="$(find epic_planner)/config/replanned_bag.rviz"/>

  <param name="/use_sim_time" value="true"/>

  <!-- Replay only the planner and trajectory sampler. Flight-control,
       avoidance, recording, and sensor-driver nodes are intentionally omitted. -->
  <include file="$(find epic_planner)/launch/algorithm.xml">
    <arg name="config_file" value="$(arg config_file)"/>
  </include>
  <node pkg="plan_manage" name="traj_server" type="traj_server"
        output="screen"/>

  <!-- A recorded vehicle cannot respond to takeoff commands. Start exploration
       as soon as odometry/cloud input is available. -->
  <param name="/exploration_node/fsm/takeoff_height" value="-1.0"/>
  <param name="/exploration_node/planner_debug/enable" value="true"/>

  <node pkg="rostopic" type="rostopic" name="auto_trigger" output="screen"
        args="pub -r 10 /waypoint_generator/waypoints nav_msgs/Path
              '{poses: [{pose: {position: {x: 0.0, y: 0.0, z: 0.0}, orientation: {x: 0.0, y: 0.0, z: 0.0, w: 1.0}}}]}'"/>

  <!-- bag_replay.py excludes recorded /planning/*, /position_cmd,
       /visualizer/* and topology outputs. RViz therefore receives only results
       generated by the current executable. -->
  <node pkg="epic_planner" type="bag_replay.py" name="bag_replay"
        output="screen" required="true"
        args="--bag='$(arg bag)'
              --rate $(arg rate)
              --start $(arg start)
              --duration=$(arg duration)
              --delay $(arg delay)
              --minimal true"/>

  <node if="$(arg rviz)" pkg="rviz" type="rviz"
        name="replanned_bag_rviz" output="screen"
        args="-d $(arg rviz_config)"/>
</launch>
