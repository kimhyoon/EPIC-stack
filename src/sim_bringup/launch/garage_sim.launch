<launch>
  <!-- Static transforms for frame compatibility -->
  <node pkg="tf" type="static_transform_publisher" name="odom_to_world"
        args="0 0 0 0 0 0 odom world 100" />

  <node pkg="tf" type="static_transform_publisher" name="odom_to_map"
        args="0 0 0 0 0 0 odom map 100" />

  <!-- ============================================================= -->
  <!-- Parameterized MARSIM engine. Runnable directly (defaults below  -->
  <!-- reproduce map2 = poongsan_garage), but normally driven by the   -->
  <!-- per-map wrappers:                                               -->
  <!--   garage_map1_mlx.launch  map1 = garage.pcd                     -->
  <!--   garage_map2_mlx.launch  map2 = poongsan_garage.pcd            -->
  <!-- Both use the ML-X sensor config; the pre-docker 360deg variant   -->
  <!-- (config1) has no equivalent here, because MARSIM no longer takes -->
  <!-- lidar_yaw_fov/lidar_is_360 — cropping moved into                 -->
  <!-- cloud_crop_bridge, driven by cloud_crop/* in the planner yaml.   -->
  <!-- ============================================================= -->

  <!-- Map configuration -->
  <arg name="map_name" default="poongsan_garage" />
  <!-- NOT derived from map_name: map2's planner yaml is garage.yaml for
       historical reasons, map1's is garage_map1.yaml. -->
  <arg name="config_file" default="garage.yaml" />
  <!-- Both scans live under their real names in map_generator/resource:
         poongsan_garage.pcd  SHA256 873398fb…  x -0.09..38.91, y -9.62..18.31
         garage.pcd           SHA256 1f87e77d…  x -5.13..177.33, y -4.60..144.27
       *.pcd is gitignored, so these are installed locally, never cloned. -->
  <arg name="map_pcd" default="$(find map_generator)/resource/$(arg map_name).pcd" />
  <!-- RViz-only overlay (display "original_garage_pcd"); never feeds MARSIM
       sensing or EPIC, so it is safe to decimate. Defaults to the full scan so
       this launch works with nothing but the map itself.
       The full scans are dense enough to stall the RViz view (1.4M pts for
       poongsan, 19.3M for garage). For a lighter overlay, make a decimated copy
       and pass it — it is purely cosmetic:
         rosrun map_generator pcd_voxel_downsample \
             <map>.pcd <map>_rviz.pcd <leaf_m>
         roslaunch sim_bringup garage_map2_mlx.launch \
             rviz_map_pcd:=$(find map_generator)/resource/poongsan_garage_rviz.pcd
       Measured: poongsan leaf 0.20 -> 108k pts, garage leaf 0.50 -> 406k pts. -->
  <arg name="rviz_map_pcd" default="$(arg map_pcd)" />

  <!-- Coverage-evaluation bounds. MUST follow the map: scoring a 39x28 m site
       against the 182x150 box silently deflates coverage. Defaults = map2. -->
  <arg name="eval_map_min_x" default="-2.0" />
  <arg name="eval_map_min_y" default="-11.0" />
  <arg name="eval_map_min_z" default="-0.2" />
  <arg name="eval_map_max_x" default="40.0" />
  <arg name="eval_map_max_y" default="20.0" />
  <arg name="eval_map_max_z" default="3.8" />

  <!-- Sensor publish rate control -->
  <arg name="odom_publish_rate" default="10.0" />
  <arg name="sensing_rate" default="10.0" />

  <!-- Odometry topic (configure based on your odometry source) -->
  <arg name="odom_topic" default="/quad_0/lidar_slam/odom" />

  <!-- Spawn pose for both MARSIM dynamics and the RViz drone marker. Defaults
       track map2 (poongsan_garage), matching garage_map2_mlx.launch. The floor
       is z=0; z=1.0 spawns inside garage.yaml's planning box (box_0/down
       z=0.55) — a 0.5 spawn starts just below it. The map begins near x=0, so
       use an interior free-space column, not the scan boundary. -->
  <arg name="init_x_" default="3.0" />
  <arg name="init_y_" default="8.0" />
  <arg name="init_z_" default="1.0" />
  <arg name="init_yaw" default="0.0" />

  <!-- garage.yaml enables ML-X FOV emulation by default. Set this argument
       false explicitly when validating the raw MARSIM cloud path. -->
  <arg name="use_cloud_crop_bridge" default="true" />

  <!-- Simulation-only reactive local avoidance. Real flight uses real_flight.launch. -->
  <arg name="enable_avoidance" default="false" />

  <!-- Evaluation parameters -->
  <arg name="eval_output_dir" default="$(find epic_planner)/experiments" />
  <arg name="eval_auto_shutdown" default="false" />
  <arg name="record_results" default="true" />
  <!-- After FINISH, seal all result artifacts and stop the complete roslaunch. -->
  <arg name="shutdown_on_finish" default="true" />
  <!-- Ignore transient FINISH states that immediately enter EARLY_FINISH. -->
  <arg name="finish_confirm_delay" default="0.25" />
  <!-- Root-cause recording is intentionally opt-in because full cloud and
       planner evidence topics can perturb timing measurements. -->
  <arg name="record_planner_debug" default="false" />
  <arg name="result_root" default="$(find sim_bringup)/../../result" />
  <arg name="result_tmp_root" default="/dev/shm/epic_sim_results" />
  <arg name="workspace_root" default="$(find sim_bringup)/../.." />

  <!-- Trajectory/Waypoint server -->
  <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator" output="screen">
    <remap from="~odom" to="$(arg odom_topic)" />
    <remap from="~goal" to="/move_base_simple/goal" />
    <remap from="~traj_start_trigger" to="/traj_start_trigger" />
    <param name="waypoint_type" value="point" />
  </node>

  <!-- Odometry visualization -->
  <node pkg="odom_visualization" name="quad0_odom_visualization" type="odom_visualization" output="screen">
    <remap from="~odom" to="$(arg odom_topic)" />
    <!-- Keep the visualization marker aligned with the actual MARSIM spawn. -->
    <param name="init_x" value="$(arg init_x_)" />
    <param name="init_y" value="$(arg init_y_)" />
    <param name="init_z" value="$(arg init_z_)" />
    <param name="color/a" value="1.0" />
    <param name="color/r" value="0.0" />
    <param name="color/g" value="1.0" />
    <param name="color/b" value="1.0" />
    <param name="covariance_scale" value="100.0" />
    <param name="robot_scale" value="1.0" />
    <param name="quadrotor_name" value="quad0" />
    <param name="drone_id" value="0" />
    <param name="mesh_resource" value="package://odom_visualization/meshes/yunque.dae" />
  </node>

  <!-- EPIC exploration algorithm. When cloud_crop/enable is true, EPIC's
       LIO/FSM subscribers select cloud_crop/output_topic themselves. -->
  <param name="/exploration_node/planner_debug/enable"
         value="$(arg record_planner_debug)" />
  <include file="$(find epic_planner)/launch/algorithm.xml">
    <arg name="config_file" value="$(arg config_file)" />
  </include>
  <!-- Keep EPIC and the bridge mode synchronized. The explicit launch
       argument overrides garage.yaml for raw-cloud validation runs. -->
  <param name="/exploration_node/cloud_crop/enable"
         value="$(arg use_cloud_crop_bridge)" />

  <!-- ML-X FOV emulation for simulation:
       MARSIM still publishes the full Mid-360 cloud, while this bridge crops
       only the cloud consumed by EPIC according to garage.yaml cloud_crop/*.
       This mirrors real_flight.launch and avoids changing MARSIM sensing. -->
  <group if="$(arg use_cloud_crop_bridge)">
    <node pkg="ml_x_cropping" name="cloud_crop_bridge" type="cloud_crop_bridge" output="screen">
      <rosparam file="$(find epic_planner)/config/$(arg config_file)" command="load" />
    </node>
  </group>

  <!-- Trajectory server publishes MINCO trajectory and hover commands to /position_cmd.
       The enable_avoidance groups route /position_cmd to /planning/pos_cmd.
       Do not remap traj_server itself. -->
  <node pkg="plan_manage" name="traj_server" type="traj_server" output="screen" />

  <!-- ===== Simulation-only reactive local avoidance, controlled by enable_avoidance. =====
       Real flight uses px4_ctrl_bridge plus the real /livox/lidar path. -->
  <group if="$(arg enable_avoidance)">
    <!-- 1) LiDAR bridge: MARSIM world PointCloud2 -> Livox CustomMsg. -->
    <node pkg="local_avoidance" type="pc2_to_livox.py" name="pc2_to_livox" output="screen">
      <param name="cloud_topic" value="/quad0_pcl_render_node/cloud" />
      <param name="odom_topic"  value="$(arg odom_topic)" />
      <param name="livox_topic" value="/livox/lidar" />
      <param name="max_range"   value="20.0" />
      <param name="max_points"  value="4000" />
    </node>

    <!-- 2) Reactive local avoidance node. Publishes /target_avoidance and /FSM_flag_avoidance. -->
    <include file="$(find local_avoidance)/launch/local_avoidance.launch">
      <arg name="lidar_topic" value="/livox/lidar" />
      <arg name="odom_topic"  value="$(arg odom_topic)" />
    </include>

    <!-- 3) MUX: flag=1 selects avoidance; otherwise EPIC command passes through. -->
    <node pkg="local_avoidance" type="avoid_mux.py" name="avoid_mux" output="screen">
      <param name="enable_avoidance"  value="true" />
      <param name="epic_topic"        value="/position_cmd" />
      <param name="out_topic"         value="/planning/pos_cmd" />
      <param name="flag_timeout"      value="0.5" />
      <param name="avoid_cmd_timeout" value="0.3" />
    </node>
  </group>

  <group unless="$(arg enable_avoidance)">
    <!-- Avoidance OFF: relay EPIC /position_cmd directly to cascadePID. -->
    <node pkg="topic_tools" type="relay" name="epic_cmd_relay"
          args="/position_cmd /planning/pos_cmd" output="screen" />
  </group>

  <!-- One-command simulation result collection. The manager runs the original
       EPIC evaluator and planning metric scripts unchanged, keeps runtime CSV
       writes in tmpfs, and starts the original plotters only after FINISH. -->
  <group if="$(arg record_results)">
    <node pkg="sim_bringup" name="sim_result_manager"
          type="sim_result_manager.py" output="screen"
          required="$(arg shutdown_on_finish)">
      <param name="result_root" value="$(arg result_root)" />
      <param name="tmp_root" value="$(arg result_tmp_root)" />
      <param name="test_prefix" value="test" />
      <param name="experiment_name" value="epic_planning" />
      <param name="odom_topic" value="$(arg odom_topic)" />
      <param name="position_cmd_topic" value="/planning/pos_cmd" />
      <param name="planner_debug_enabled" value="$(arg record_planner_debug)" />
      <param name="shutdown_on_finish" value="$(arg shutdown_on_finish)" />
      <param name="finish_confirm_delay" value="$(arg finish_confirm_delay)" />
      <param name="config_path" value="$(find epic_planner)/config/$(arg config_file)" />
      <param name="use_cloud_crop_bridge" value="$(arg use_cloud_crop_bridge)" />
      <param name="enable_avoidance" value="$(arg enable_avoidance)" />
      <param name="workspace_root" value="$(arg workspace_root)" />
      <param name="pcd_path" value="$(arg map_pcd)" />
      <param name="cell_size" value="0.4" />
      <param name="map_min_x" value="$(arg eval_map_min_x)" />
      <param name="map_min_y" value="$(arg eval_map_min_y)" />
      <param name="map_min_z" value="$(arg eval_map_min_z)" />
      <param name="map_max_x" value="$(arg eval_map_max_x)" />
      <param name="map_max_y" value="$(arg eval_map_max_y)" />
      <param name="map_max_z" value="$(arg eval_map_max_z)" />
    </node>
  </group>

  <!-- Preserve the previous direct evaluator path when automatic result
       management is explicitly disabled. -->
  <group unless="$(arg record_results)">
    <node pkg="epic_planner" name="exploration_evaluator"
          type="evaluate_exploration.py" output="screen">
      <param name="odom_topic" value="$(arg odom_topic)" />
      <param name="position_cmd_topic" value="/planning/pos_cmd" />
      <param name="pcd_path" value="$(arg map_pcd)" />
      <param name="cell_size" value="0.4" />
      <param name="map_min_x" value="$(arg eval_map_min_x)" />
      <param name="map_min_y" value="$(arg eval_map_min_y)" />
      <param name="map_min_z" value="$(arg eval_map_min_z)" />
      <param name="map_max_x" value="$(arg eval_map_max_x)" />
      <param name="map_max_y" value="$(arg eval_map_max_y)" />
      <param name="map_max_z" value="$(arg eval_map_max_z)" />
      <param name="output_dir" value="$(arg eval_output_dir)" />
      <param name="auto_shutdown" value="$(arg eval_auto_shutdown)" />
    </node>
  </group>

  <!-- RViz-only downsampled map overlay. The latched publisher loads and sends
       this asset once, then stays alive for later RViz subscriptions without
       repeatedly serializing the cloud during planner timing measurements. -->
  <node pkg="map_generator" name="generated_pcd_map_publisher"
        type="static_pcd_publisher" output="screen">
    <param name="file_name" value="$(arg rviz_map_pcd)" />
    <param name="frame_id" value="world" />
    <param name="topic_name" value="/debug/generated_pcd_map" />
  </node>

  <!-- Simulation environment (garage map with drone) -->
  <include file="$(find mars_drone_sim)/launch/garage.launch">
    <arg name="map_name" value="$(arg map_pcd)" />
    <arg name="sensing_horizon" value="60.0" />
    <arg name="init_x_" value="$(arg init_x_)" />
    <arg name="init_y_" value="$(arg init_y_)" />
    <arg name="init_z_" value="$(arg init_z_)" />
    <arg name="init_yaw" value="$(arg init_yaw)" />
    <!-- The MARSIM launch chain does not consume odom_publish_rate/sensing_rate
         as args. Passing them here causes roslaunch "unused args" errors. -->
  </include>

  <!-- RViz visualization -->
  <include file="$(find epic_planner)/launch/rviz.launch" />
</launch>
