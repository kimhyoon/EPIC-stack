<launch>
  <!-- map1 = garage.pcd  x  ML-X sensor config (120deg x 30deg cloud crop).
       roslaunch sim_bringup garage_map1_mlx.launch

       Restored from the pre-docker tree's garage_map1_config2.launch. The old
       "config1" (360deg tilted MARSIM sensor) has no counterpart here: this
       MARSIM no longer accepts lidar_yaw_fov / lidar_vertical_fov /
       lidar_is_360. MARSIM renders the full Mid-360 cloud and cloud_crop_bridge
       crops only what EPIC consumes, per cloud_crop/* in garage_map1.yaml. -->

  <!-- ======== SET THIS LAUNCH'S DRONE START POSE HERE ========
       Carried over verbatim from garage_map1_config2.launch. Override on the
       CLI, e.g.:
         roslaunch sim_bringup garage_map1_mlx.launch init_x_:=10 init_y_:=5 -->
  <arg name="init_x_"   default="5.0" />
  <arg name="init_y_"   default="0.0" />
  <!-- 0.3: map1 바닥은 (5,0) 부근에서 z=0.00, planning_box_0/down 의 z 하한은 0.2.
       옛 값 2.0 은 takeoff_height(1.25, 절대 z)보다 높아 트리거 시 기체가 이륙이
       아니라 0.75m 하강했다. 시뮬은 지면 접촉이 없으므로 스폰 고도가 곧 지면
       기준(land_ground_z_)이 된다. -->
  <arg name="init_z_"   default="0.3" />
  <arg name="init_yaw"  default="0.0" />
  <!-- ========================================================= -->

  <!-- true (default): cascadePID only ingests position + yaw, matching PX4's
       type_mask=2552 in OFFBOARD. false: legacy full pos+vel+acc feed-forward.
       roslaunch only applies a CLI override (use_px4_bridge:=...) to an <arg>
       declared in the launch file given directly to roslaunch, so this must be
       re-declared (and passed through) at every wrapper down to cascadePID. -->
  <arg name="use_px4_bridge" default="true" />
  <arg name="auto_rth_land" default="false" />
  <arg name="rviz" default="true" />
  <arg name="record_results" default="true" />
  <arg name="eval_output_dir" default="$(find epic_planner)/experiments" />
  <arg name="shutdown_on_finish" default="true" />

  <include file="$(find sim_bringup)/launch/garage_sim.launch">
    <arg name="map_name" value="garage" />
    <arg name="config_file" value="garage_map1.yaml" />

    <!-- map1 eval bounds (garage.pcd extent; from garage_base.launch defaults) -->
    <arg name="eval_map_min_x" value="-10.0" />
    <arg name="eval_map_min_y" value="-6.0" />
    <arg name="eval_map_min_z" value="-0.2" />
    <arg name="eval_map_max_x" value="182.0" />
    <arg name="eval_map_max_y" value="150.2" />
    <arg name="eval_map_max_z" value="3.8" />

    <arg name="init_x_" value="$(arg init_x_)" />
    <arg name="init_y_" value="$(arg init_y_)" />
    <arg name="init_z_" value="$(arg init_z_)" />
    <arg name="init_yaw" value="$(arg init_yaw)" />
    <arg name="use_px4_bridge" value="$(arg use_px4_bridge)" />
    <arg name="auto_rth_land" value="$(arg auto_rth_land)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="record_results" value="$(arg record_results)" />
    <arg name="eval_output_dir" value="$(arg eval_output_dir)" />
    <arg name="shutdown_on_finish" value="$(arg shutdown_on_finish)" />
  </include>
</launch>
